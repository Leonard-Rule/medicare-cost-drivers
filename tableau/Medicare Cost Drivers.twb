caption="Sex" datatype='string' name='[sex]' role='dimension' type='nominal' /><column caption="Year" datatype='integer' name='[yr]' role='dimension' type='ordinal' /><column-instance column='[Calculation_total_pmpm]' derivation='User' name='[usr:Calculation_total_pmpm:qk]' pivot='key' type='quantitative' /><column-instance column='[age_band]' derivation='None' name='[none:age_band:nk]' pivot='key' type='nominal' /><column-instance column='[dual_status]' derivation='None' name='[none:dual_status:nk]' pivot='key' type='nominal' /><column-instance column='[sex]' derivation='None' name='[none:sex:nk]' pivot='key' type='nominal' /><column-instance column='[yr]' derivation='None' name='[none:yr:ok]' pivot='key' type='ordinal' /></datasource-dependencies>
