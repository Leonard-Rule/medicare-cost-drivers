<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2023.1.0 (20231.23.0310.1045)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences><preference name='ui.encoding.shelf.height' value='24' /><preference name='ui.shelf.height' value='26' /></preferences>
  
  <datasources>
    <datasource caption='Medicare Cost Drivers' inline='true' name='federated.0mcd0pmpm00001' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='tableau_data' name='textscan.0mcd0csv000001'>
            <connection class='textscan' directory='Data/output' filename='tableau_data.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.0mcd0csv000001' name='tableau_data.csv' table='[tableau_data#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name="row_type" ordinal='0' /><column datatype='integer' name="yr" ordinal='1' /><column datatype='string' name="service_category" ordinal='2' /><column datatype='string' name="subcategory" ordinal='3' /><column datatype='string' name="type_of_service" ordinal='4' /><column datatype='string' name="service_group" ordinal='5' /><column datatype='string' name="dual_status" ordinal='6' /><column datatype='string' name="age_band" ordinal='7' /><column datatype='string' name="sex" ordinal='8' /><column datatype='real' name="allowed" ordinal='9' /><column datatype='real' name="pc_allowed" ordinal='10' /><column datatype='integer' name="ab_mm" ordinal='11' /><column datatype='integer' name="pd_mm" ordinal='12' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="Row Type" datatype='string' name='[row_type]' role='dimension' type='nominal' /><column caption="Year" datatype='integer' name='[yr]' role='dimension' type='ordinal' /><column caption="Service Category" datatype='string' name='[service_category]' role='dimension' type='nominal' /><column caption="Subcategory" datatype='string' name='[subcategory]' role='dimension' type='nominal' /><column caption="Type of Service" datatype='string' name='[type_of_service]' role='dimension' type='nominal' /><column caption="Primary Care Service Group" datatype='string' name='[service_group]' role='dimension' type='nominal' /><column caption="Medicaid (Dual) Status" datatype='string' name='[dual_status]' role='dimension' type='nominal' /><column caption="Age Band" datatype='string' name='[age_band]' role='dimension' type='nominal' /><column caption="Sex" datatype='string' name='[sex]' role='dimension' type='nominal' /><column caption="Allowed $" datatype='real' name='[allowed]' role='measure' type='quantitative' /><column caption="Primary Care Allowed $" datatype='real' name='[pc_allowed]' role='measure' type='quantitative' /><column caption="A+B FFS Member Months (row)" datatype='integer' name='[ab_mm]' role='measure' type='quantitative' /><column caption="Part D Member Months (row)" datatype='integer' name='[pd_mm]' role='measure' type='quantitative' /><column caption="Member Months A+B FFS" datatype='integer' name='[Calculation_mm_ab]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [yr] : SUM([ab_mm])}" /></column><column caption="Member Months Part D" datatype='integer' name='[Calculation_mm_pd]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [yr] : SUM([pd_mm])}" /></column><column caption="PMPM Denominator" datatype='integer' name='[Calculation_denom]' role='measure' type='quantitative'><calculation class='tableau' formula="IF [service_category] = 'Retail Pharmacy' THEN [Calculation_mm_pd] ELSE [Calculation_mm_ab] END" /></column><column caption="PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="// Allowed $ per member per month. Retail pharmacy uses Part D months, everything else A+B FFS months.&#10;SUM([allowed]) / MIN([Calculation_denom])" /></column><column caption="Total PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_total_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [service_category] &lt;&gt; 'Retail Pharmacy' THEN [allowed] END) / MIN([Calculation_mm_ab])&#10;+ ZN(SUM(IF [service_category] = 'Retail Pharmacy' THEN [allowed] END) / MIN([Calculation_mm_pd]))" /></column><column caption="Primary Care % of Medical Spend" datatype='real' default-format="0.00%" name='[Calculation_pc_share]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([pc_allowed]) / SUM(IF [row_type] = 'spend' AND [service_category] &lt;&gt; 'Retail Pharmacy' THEN [allowed] END)" /></column><column caption="Primary Care PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_pc_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([pc_allowed]) / MIN([Calculation_mm_ab])" /></column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="PMPM by Category">
      <layout-options><title><formatted-text><run fontsize='12' bold='true'>Allowed PMPM by Peterson-Milbank service category</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='Medicare Cost Drivers' name='federated.0mcd0pmpm00001' /></datasources>
          <datasource-dependencies datasource='federated.0mcd0pmpm00001'><column caption="PMPM Denominator" datatype='integer' name='[Calculation_denom]' role='measure' type='quantitative'><calculation class='tableau' formula="IF [service_category] = 'Retail Pharmacy' THEN [Calculation_mm_pd] ELSE [Calculation_mm_ab] END" /></column><column caption="Member Months A+B FFS" datatype='integer' name='[Calculation_mm_ab]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [yr] : SUM([ab_mm])}" /></column><column caption="Member Months Part D" datatype='integer' name='[Calculation_mm_pd]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [yr] : SUM([pd_mm])}" /></column><column caption="PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="// Allowed $ per member per month. Retail pharmacy uses Part D months, everything else A+B FFS months.&#10;SUM([allowed]) / MIN([Calculation_denom])" /></column><column caption="A+B FFS Member Months (row)" datatype='integer' name='[ab_mm]' role='measure' type='quantitative' /><column caption="Age Band" datatype='string' name='[age_band]' role='dimension' type='nominal' /><column caption="Allowed $" datatype='real' name='[allowed]' role='measure' type='quantitative' /><column caption="Medicaid (Dual) Status" datatype='string' name='[dual_status]' role='dimension' type='nominal' /><column caption="Primary Care Allowed $" datatype='real' name='[pc_allowed]' role='measure' type='quantitative' /><column caption="Part D Member Months (row)" datatype='integer' name='[pd_mm]' role='measure' type='quantitative' /><column caption="Row Type" datatype='string' name='[row_type]' role='dimension' type='nominal' /><column caption="Service Category" datatype='string' name='[service_category]' role='dimension' type='nominal' /><column caption="Sex" datatype='string' name='[sex]' role='dimension' type='nominal' /><column caption="Year" datatype='integer' name='[yr]' role='dimension' type='ordinal' /><column-instance column='[Calculation_pmpm]' derivation='User' name='[usr:Calculation_pmpm:qk]' pivot='key' type='quantitative' /><column-instance column='[age_band]' derivation='None' name='[none:age_band:nk]' pivot='key' type='nominal' /><column-instance column='[dual_status]' derivation='None' name='[none:dual_status:nk]' pivot='key' type='nominal' /><column-instance column='[row_type]' derivation='None' name='[none:row_type:nk]' pivot='key' type='nominal' /><column-instance column='[service_category]' derivation='None' name='[none:service_category:nk]' pivot='key' type='nominal' /><column-instance column='[sex]' derivation='None' name='[none:sex:nk]' pivot='key' type='nominal' /><column-instance column='[yr]' derivation='None' name='[none:yr:ok]' pivot='key' type='ordinal' /></datasource-dependencies>
          <filter class='categorical' column='[federated.0mcd0pmpm00001].[none:dual_status:nk]' context='true'><groupfilter function='level-members' level='[none:dual_status:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><filter class='categorical' column='[federated.0mcd0pmpm00001].[none:age_band:nk]' context='true'><groupfilter function='level-members' level='[none:age_band:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><filter class='categorical' column='[federated.0mcd0pmpm00001].[none:sex:nk]' context='true'><groupfilter function='level-members' level='[none:sex:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><filter class='categorical' column='[federated.0mcd0pmpm00001].[none:row_type:nk]'><groupfilter function='member' level='[none:row_type:nk]' member='&quot;spend&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter>
          <slices><column>[federated.0mcd0pmpm00001].[none:dual_status:nk]</column><column>[federated.0mcd0pmpm00001].[none:age_band:nk]</column><column>[federated.0mcd0pmpm00001].[none:sex:nk]</column><column>[federated.0mcd0pmpm00001].[none:row_type:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='mark'><encoding attr='color' field='[federated.0mcd0pmpm00001].[none:service_category:nk]' type='palette'><map to='#2a78d6'><bucket>&quot;Inpatient Hospital&quot;</bucket></map><map to='#eb6834'><bucket>&quot;Outpatient Hospital&quot;</bucket></map><map to='#1baf7a'><bucket>&quot;Professional&quot;</bucket></map><map to='#eda100'><bucket>&quot;Long-Term Care&quot;</bucket></map><map to='#e87ba4'><bucket>&quot;Retail Pharmacy&quot;</bucket></map><map to='#008300'><bucket>&quot;Other&quot;</bucket></map></encoding></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.0mcd0pmpm00001].[none:service_category:nk]' /></encodings>
            
          </pane>
        </panes>
        <rows>[federated.0mcd0pmpm00001].[usr:Calculation_pmpm:qk]</rows>
        <cols>[federated.0mcd0pmpm00001].[none:yr:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Total PMPM Trend">
