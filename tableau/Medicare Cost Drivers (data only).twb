<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2023.1.0 (20231.23.0310.1045)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences><preference name='ui.encoding.shelf.height' value='24' /><preference name='ui.shelf.height' value='26' /></preferences>
  
  <datasources>
    <datasource caption='Medicare Cost Drivers' inline='true' name='federated.0mcd0pmpm00001' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='tableau_data' name='textscan.0mcd0csv000001'>
            <connection class='textscan' directory='Data/output' filename='tableau_data.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.0mcd0csv000001' name='tableau_data.csv' table='[tableau_data#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name="row_type" ordinal='0' /><column datatype='integer' name="yr" ordinal='1' /><column datatype='string' name="service_category" ordinal='2' /><column datatype='string' name="subcategory" ordinal='3' /><column datatype='string' name="type_of_service" ordinal='4' /><column datatype='string' name="service_group" ordinal='5' /><column datatype='string' name="dual_status" ordinal='6' /><column datatype='string' name="age_band" ordinal='7' /><column datatype='string' name="sex" ordinal='8' /><column datatype='real' name="allowed" ordinal='9' /><column datatype='real' name="pc_allowed" ordinal='10' /><column datatype='integer' name="ab_mm" ordinal='11' /><column datatype='integer' name="pd_mm" ordinal='12' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="Row Type" datatype='string' name='[row_type]' role='dimension' type='nominal' /><column caption="Year" datatype='integer' name='[yr]' role='dimension' type='ordinal' /><column caption="Service Category" datatype='string' name='[service_category]' role='dimension' type='nominal' /><column caption="Subcategory" datatype='string' name='[subcategory]' role='dimension' type='nominal' /><column caption="Type of Service" datatype='string' name='[type_of_service]' role='dimension' type='nominal' /><column caption="Primary Care Service Group" datatype='string' name='[service_group]' role='dimension' type='nominal' /><column caption="Medicaid (Dual) Status" datatype='string' name='[dual_status]' role='dimension' type='nominal' /><column caption="Age Band" datatype='string' name='[age_band]' role='dimension' type='nominal' /><column caption="Sex" datatype='string' name='[sex]' role='dimension' type='nominal' /><column caption="Allowed $" datatype='real' name='[allowed]' role='measure' type='quantitative' /><column caption="Primary Care Allowed $" datatype='real' name='[pc_allowed]' role='measure' type='quantitative' /><column caption="A+B FFS Member Months (row)" datatype='integer' name='[ab_mm]' role='measure' type='quantitative' /><column caption="Part D Member Months (row)" datatype='integer' name='[pd_mm]' role='measure' type='quantitative' /><column caption="Member Months A+B FFS" datatype='integer' name='[Calculation_mm_ab]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [yr] : SUM([ab_mm])}" /></column><column caption="Member Months Part D" datatype='integer' name='[Calculation_mm_pd]' role='measure' type='quantitative'><calculation class='tableau' formula="{FIXED [yr] : SUM([pd_mm])}" /></column><column caption="PMPM Denominator" datatype='integer' name='[Calculation_denom]' role='measure' type='quantitative'><calculation class='tableau' formula="IF [service_category] = 'Retail Pharmacy' THEN [Calculation_mm_pd] ELSE [Calculation_mm_ab] END" /></column><column caption="PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="// Allowed $ per member per month. Retail pharmacy uses Part D months, everything else A+B FFS months.&#10;SUM([allowed]) / MIN([Calculation_denom])" /></column><column caption="Total PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_total_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [service_category] &lt;&gt; 'Retail Pharmacy' THEN [allowed] END) / MIN([Calculation_mm_ab])&#10;+ ZN(SUM(IF [service_category] = 'Retail Pharmacy' THEN [allowed] END) / MIN([Calculation_mm_pd]))" /></column><column caption="Primary Care % of Medical Spend" datatype='real' default-format="0.00%" name='[Calculation_pc_share]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([pc_allowed]) / SUM(IF [row_type] = 'spend' AND [service_category] &lt;&gt; 'Retail Pharmacy' THEN [allowed] END)" /></column><column caption="Primary Care PMPM" datatype='real' default-format='"$"#,##0.00' name='[Calculation_pc_pmpm]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([pc_allowed]) / MIN([Calculation_mm_ab])" /></column>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets><worksheet name="Sheet 1"><table><view><datasources /><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Automatic' /></pane></panes><rows /><cols /></table></worksheet></worksheets><windows source-height='30'><window class='worksheet' name="Sheet 1"><cards>
          <edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge>
          <edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge>
        </cards></window></windows>
</workbook>
